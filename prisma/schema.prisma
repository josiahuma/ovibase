generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Attendance {
  id        String   @id @db.VarChar(32)
  tenantId  String   @db.VarChar(30)
  men       Int
  women     Int
  children  Int
  date      DateTime
  event     String
  total     Int
  createdAt DateTime @default(now())
  updatedAt DateTime

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "Attendance_tenantId_fkey")

  @@index([tenantId, date], map: "Attendance_tenantId_date_idx")
  @@map("Attendance")
}

model ChurchUnitCategory {
  id        String   @id @db.VarChar(32)
  tenantId  String   @db.VarChar(30)
  name      String
  alias     String
  createdAt DateTime @default(now())
  updatedAt DateTime

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "ChurchUnitCategory_tenantId_fkey")

  @@unique([tenantId, alias], map: "ChurchUnitCategory_tenantId_alias_key")
  @@index([tenantId], map: "ChurchUnitCategory_tenantId_idx")
  @@map("ChurchUnitCategory")
}

model Domain {
  id        String   @id @db.VarChar(30)
  tenantId  String   @db.VarChar(30)
  hostname  String   @unique(map: "Domain_hostname_key")
  isPrimary Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "Domain_tenantId_fkey")

  @@index([tenantId], map: "Domain_tenantId_idx")
  @@map("Domain")
}

model Donation {
  id                    String          @id @db.VarChar(30)
  tenantId              String          @db.VarChar(30)
  amount                Decimal         @db.Decimal(10, 2)
  currency              String          @db.VarChar(10)
  isRecurring           Boolean         @default(false)
  interval              String?         @db.VarChar(16)
  giftAid               Boolean         @default(false)
  donorName             String?
  donorEmail            String?
  address1              String?
  address2              String?
  city                  String?
  county                String?
  postcode              String?         @db.VarChar(32)
  country               String?         @db.VarChar(2)
  status                donation_status @default(PENDING)
  stripeSessionId       String?         @unique(map: "Donation_stripeSessionId_key")
  stripePaymentIntentId String?         @unique(map: "Donation_stripePaymentIntentId_key")
  stripeSubscriptionId  String?         @unique(map: "Donation_stripeSubscriptionId_key")
  createdAt             DateTime        @default(now())
  paidAt                DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "Donation_tenantId_fkey")

  @@index([tenantId, createdAt], map: "Donation_tenantId_createdAt_idx")
  @@index([tenantId, status], map: "Donation_tenantId_status_idx")
  @@map("Donation")
}

model DonationFund {
  id        String   @id @db.VarChar(30)
  tenantId  String   @db.VarChar(30)
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "DonationFund_tenantId_fkey")

  @@unique([tenantId, name], map: "DonationFund_tenantId_name_key")
  @@index([tenantId], map: "DonationFund_tenantId_idx")
  @@index([tenantId, isDefault], map: "DonationFund_tenantId_isDefault_idx")
  @@map("DonationFund")
}

model EventCategory {
  id        String   @id @db.VarChar(32)
  tenantId  String   @db.VarChar(30)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "EventCategory_tenantId_fkey")

  @@unique([tenantId, name], map: "EventCategory_tenantId_name_key")
  @@index([tenantId], map: "EventCategory_tenantId_idx")
  @@map("EventCategory")
}

model ExpenseCategory {
  id        String   @id @db.VarChar(30)
  tenantId  String   @db.VarChar(30)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "ExpenseCategory_tenantId_fkey")

  @@unique([tenantId, name], map: "ExpenseCategory_tenantId_name_key")
  @@index([tenantId], map: "ExpenseCategory_tenantId_idx")
  @@map("ExpenseCategory")
}

model Finance {
  id          String   @id @db.VarChar(30)
  tenantId    String   @db.VarChar(30)
  amount      Decimal  @db.Decimal(10, 2)
  type        String   @db.VarChar(32)
  category    String?  @db.VarChar(180)
  description String?
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  donationId  String?  @unique(map: "Finance_donationId_key") @db.VarChar(30)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "Finance_tenantId_fkey")

  @@index([tenantId, category], map: "Finance_tenantId_category_idx")
  @@index([tenantId, date], map: "Finance_tenantId_date_idx")
  @@index([tenantId, type], map: "Finance_tenantId_type_idx")
  @@map("Finance")
}

model IncomeCategory {
  id        String   @id @db.VarChar(30)
  tenantId  String   @db.VarChar(30)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "IncomeCategory_tenantId_fkey")

  @@unique([tenantId, name], map: "IncomeCategory_tenantId_name_key")
  @@index([tenantId], map: "IncomeCategory_tenantId_idx")
  @@map("IncomeCategory")
}

model Leader {
  id           String   @id @db.VarChar(32)
  tenantId     String   @db.VarChar(30)
  firstName    String
  lastName     String
  mobileNumber String   @db.VarChar(32)
  email        String
  churchUnit   String
  membersCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "Leader_tenantId_fkey")

  @@unique([tenantId, email], map: "Leader_tenantId_email_key")
  @@index([tenantId], map: "Leader_tenantId_idx")
  @@map("Leader")
}

model Member {
  id              String    @id @db.VarChar(32)
  tenantId        String    @db.VarChar(30)
  firstName       String
  lastName        String?
  gender          String?   @db.VarChar(32)
  mobileNumber    String?   @db.VarChar(32)
  email           String?
  dateOfBirth     DateTime?
  anniversaryDate DateTime?
  churchUnit      String?
  churchLeader    String?
  customFields    Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "Member_tenantId_fkey")

  @@index([tenantId, email], map: "Member_tenantId_email_idx")
  @@index([tenantId], map: "Member_tenantId_idx")
  @@index([tenantId, mobileNumber], map: "Member_tenantId_mobileNumber_idx")
  @@map("Member")
}

model MemberSubmission {
  id              String                  @id @db.VarChar(30)
  tenantId        String                  @db.VarChar(30)
  firstName       String
  lastName        String?
  gender          String?                 @db.VarChar(32)
  mobileNumber    String?                 @db.VarChar(32)
  email           String?
  dateOfBirth     DateTime?
  anniversaryDate DateTime?
  churchUnit      String?
  churchLeader    String?
  status          membersubmission_status @default(PENDING)
  reviewedAt      DateTime?
  reviewedBy      String?                 @db.VarChar(30)
  rejectReason    String?                 @db.Text
  memberId        String?                 @unique(map: "MemberSubmission_memberId_key") @db.VarChar(30)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "MemberSubmission_tenantId_fkey")

  @@index([tenantId, createdAt], map: "MemberSubmission_tenantId_createdAt_idx")
  @@index([tenantId, email], map: "MemberSubmission_tenantId_email_idx")
  @@index([tenantId, mobileNumber], map: "MemberSubmission_tenantId_mobileNumber_idx")
  @@index([tenantId, status], map: "MemberSubmission_tenantId_status_idx")
  @@map("MemberSubmission")
}

model SmsLog {
  id         String           @id @db.VarChar(30)
  tenantId   String           @db.VarChar(30)
  templateId String?
  memberId   String?
  to         String           @db.VarChar(64)
  message    String           @db.Text
  status     smslog_status
  error      String?          @db.Text
  provider   smslog_provider?
  tag        String?
  createdAt  DateTime         @default(now())

  // You can add relations to SmsTemplate/Member later if needed.
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "SmsLog_tenantId_fkey")

  @@index([tenantId, createdAt], map: "SmsLog_tenantId_createdAt_idx")
  @@index([tenantId, memberId], map: "SmsLog_tenantId_memberId_idx")
  @@index([tenantId, templateId], map: "SmsLog_tenantId_templateId_idx")
  @@map("SmsLog")
}

model SmsProviderSetting {
  tenantId  String                      @id @db.VarChar(30)
  provider  smsprovidersetting_provider @default(TEXTLOCAL)
  apiKeyEnc Bytes?
  apiKeyIv  Bytes?
  apiKeyTag Bytes?
  senderId  String?                     @db.VarChar(64)
  from      String?                     @db.VarChar(64)
  baseUrl   String?
  meta      Json?
  createdAt DateTime                    @default(now())
  updatedAt DateTime

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "SmsProviderSetting_tenantId_fkey")

  @@map("SmsProviderSetting")
}

model SmsTemplate {
  id        String   @id @db.VarChar(32)
  tenantId  String   @db.VarChar(30)
  name      String
  message   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "SmsTemplate_tenantId_fkey")

  @@index([tenantId], map: "SmsTemplate_tenantId_idx")
  @@map("SmsTemplate")
}

model StripeProviderSetting {
  tenantId         String                     @id @db.VarChar(30)
  mode             stripeprovidersetting_mode @default(TEST)
  secretKeyEnc     Bytes?
  secretKeyIv      Bytes?
  secretKeyTag     Bytes?
  publishableKey   String?
  webhookSecretEnc Bytes?
  webhookSecretIv  Bytes?
  webhookSecretTag Bytes?
  currency         String                     @default("gbp") @db.VarChar(10)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime

  @@map("StripeProviderSetting")
}

model Tenant {
  id                 String               @id @db.VarChar(30)
  name               String
  slug               String               @unique(map: "Tenant_slug_key") @db.VarChar(63)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime

  attendance         Attendance[]
  churchunitcategory ChurchUnitCategory[]
  domain             Domain[]
  donationfund       DonationFund[]
  eventcategory      EventCategory[]
  expensecategory    ExpenseCategory[]
  finance            Finance[]
  incomecategory     IncomeCategory[]
  leader             Leader[]
  member             Member[]
  membersubmission   MemberSubmission[]
  smsprovidersetting SmsProviderSetting?
  smstemplate        SmsTemplate[]
  tenantsubscription TenantSubscription?
  usertenant         UserTenant[]
  donation           Donation[]
  smslog             SmsLog[]

  @@index([slug], map: "Tenant_slug_idx")
  @@map("Tenant")
}

model TenantSubscription {
  id                   String    @id
  tenantId             String    @unique(map: "TenantSubscription_tenantId_key")
  stripeCustomerId     String?   @unique(map: "TenantSubscription_stripeCustomerId_key")
  stripeSubscriptionId String?   @unique(map: "TenantSubscription_stripeSubscriptionId_key")
  stripePriceId        String?
  status               String    @default("inactive")
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "TenantSubscription_tenantId_fkey")

  @@map("TenantSubscription")
}

model User {
  id           String       @id @db.VarChar(30)
  name         String?
  email        String       @unique(map: "User_email_key")
  passwordHash String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime

  usertenant UserTenant[]

  @@map("User")
}

model UserTenant {
  id            String          @id @db.VarChar(30)
  userId        String          @db.VarChar(30)
  tenantId      String          @db.VarChar(30)
  role          usertenant_role @default(STAFF)
  createdAt     DateTime        @default(now())
  canMembers    Boolean         @default(false)
  canLeaders    Boolean         @default(false)
  canAttendance Boolean         @default(false)
  canFinance    Boolean         @default(false)
  canSms        Boolean         @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "UserTenant_tenantId_fkey")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, map: "UserTenant_userId_fkey")

  @@unique([userId, tenantId], map: "UserTenant_userId_tenantId_key")
  @@index([tenantId], map: "UserTenant_tenantId_idx")
  @@index([userId], map: "UserTenant_userId_idx")
  @@map("UserTenant")
}

enum smsprovidersetting_provider {
  TEXTLOCAL
  TWILIO
  INFOBIP
  VONAGE
  OTHER
}

enum stripeprovidersetting_mode {
  TEST
  LIVE
}

enum usertenant_role {
  OWNER
  ADMIN
  STAFF
  VIEWER
}

enum smslog_status {
  SENT
  FAILED
}

enum smslog_provider {
  TEXTLOCAL
  TWILIO
  INFOBIP
  VONAGE
  OTHER
}

enum membersubmission_status {
  PENDING
  APPROVED
  REJECTED
}

enum donation_status {
  PENDING
  PAID
  FAILED
  CANCELED
}
